# ── Obrigatória ───────────────────────────────────────────────────────────────
# Chave da API da Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# ── Segurança ─────────────────────────────────────────────────────────────────
# Origens permitidas no CORS, separadas por vírgula.
# "*" apenas em desenvolvimento; em produção use o domínio do app web.
ALLOWED_ORIGINS=*

# Segredo compartilhado com o app, exigido no header X-API-Key.
# Vazio desliga a checagem. Barra abuso casual — não substitui login de usuário.
API_KEY=

# Rate limit por IP.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Cache de respostas ────────────────────────────────────────────────────────
# Tempo de vida das respostas em cache. 0 desliga o cache.
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# ── Observabilidade ───────────────────────────────────────────────────────────
# Nível de log da aplicação: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

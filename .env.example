# ── Obrigatória ───────────────────────────────────────────────────────────────
# Chave da API da Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# ── Segurança ─────────────────────────────────────────────────────────────────
# Origens permitidas no CORS, separadas por vírgula. Vazio (padrão) não libera nenhuma
# origem de navegador; o backend MeatShop chama o serviço sem depender de CORS.
ALLOWED_ORIGINS=

# Compatibilidade legada. Não incluir no app ou painel.
API_KEY=
# Segredo exclusivo entre backend MeatShop e chatbot. Obrigatório em produção.
SERVICE_API_KEY=
# Ambiente de execução. Em "production" exige credencial interna e desliga /docs, /redoc e /openapi.json.
ENVIRONMENT=development

# Rate limit por usuário (header X-MeatShop-User enviado pelo backend), com fallback para o IP.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Cache de respostas ────────────────────────────────────────────────────────
# Tempo de vida das respostas em cache. 0 desliga o cache.
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# Limites de geração
MAX_COMPLETION_TOKENS=800
TEMPERATURE=0.25
RECIPE_DRAFT_MODEL=openai/gpt-oss-20b

# ── Observabilidade ───────────────────────────────────────────────────────────
# Nível de log da aplicação: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
